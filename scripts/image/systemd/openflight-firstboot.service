[Unit]
Description=OpenFlight first-boot hardware provisioning
Documentation=file:///opt/openflight/docs/sd-card-image.md
# Must finish before the graphical session: the kiosk autostart opens the
# radar's serial port, and firstboot writes rolling-buffer mode to that same
# port. Ordering against multi-user.target does not block graphical.target,
# and a Before= on a unit the image never installs is a no-op — the kiosk
# starts from /etc/xdg/autostart, not a systemd service.
After=local-fs.target systemd-udev-settle.service userconfig.service
Wants=systemd-udev-settle.service
Before=graphical.target
ConditionPathExists=/opt/openflight/scripts/image/firstboot.sh

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/openflight/scripts/image/firstboot.sh
# Radar flash writes and the self-test both wait on hardware; a stuck probe
# must not strand the unit before the kiosk ever starts.
TimeoutStartSec=300
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=graphical.target
